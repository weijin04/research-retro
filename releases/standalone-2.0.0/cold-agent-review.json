  "containment": "bwrap --unshare-all; read-only /venv /handoff /review and system binaries/libs; private /tmp; no developer home, original project or network; host tool access outside these calls cooperative",
  "own_script": "import json,pathlib,hashlib,math,csv,io\nroot=pathlib.Path('/handoff'); data=json.loads((root/'handoff.json').read_text()); arts={x['data']['path'].removeprefix('/sandbox/case/'):x for x in data['records'] if x['kind']=='artifact'}\ndef raw(name):\n a=arts[name]; b=next((root/'store').rglob(a['data']['sha256'])).read_bytes(); assert hashlib.sha256(b).hexdigest()==a['data']['sha256']; return b\ncfg=json.loads(raw('protocol.json')); dt=cfg['dt_s']; r=cfg['k_BA_per_s']; k=cfg['k_AB_per_s']; result=[]\nfor gate in [True,False]:\n for n in [500,cfg['requested_steps']]:\n  rate=0 if gate and k<cfg['rate_cutoff_per_s'] else k\n  p=0.\n  for i in range(n):p += dt*(rate*(1-p)-r*p)\n  closed=rate/(rate+r)*(-math.expm1(n*math.log1p(-(rate+r)*dt)))\n  continuous=rate/(rate+r)*(-math.expm1(-(rate+r)*n*dt))\n  assert abs(p-closed)<1e-12\n  result.append(dict(gate=gate,steps=n,duration=n*dt,recurrence=p,closed=closed,continuous=continuous,error=p-continuous))\nrows=list(csv.DictReader(io.StringIO(raw('results/diagnostic-b/trajectory.csv').decode())))\nerrors=[abs(float(row['p_B'])-k/(k+r)*(-math.expm1(int(row['step'])*math.log1p(-(k+r)*dt)))) for row in rows]\nprint(json.dumps(dict(matrix=result,max_archived_sample_discrete_error=max(errors),source_locators=[dict(path=n,id=a['id'],revision=a['revision'],sha256=a['data']['sha256'],start_byte=0,end_byte_exclusive=len(raw(n))) for n,a in arts.items()],original_unavailable=not pathlib.Path('/sandbox/case').exists(),developer_home_unavailable=not pathlib.Path('/home/sun07ao').exists()),indent=2))\n",
